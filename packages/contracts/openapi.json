{
  "components": {
    "schemas": {
      "AutocompleteResult": {
        "description": "At most eight normalized autocomplete suggestions.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/AutocompleteSuggestion"
            },
            "title": "Items",
            "type": "array"
          },
          "meta": {
            "$ref": "#/components/schemas/ResponseMeta"
          }
        },
        "required": [
          "items",
          "meta"
        ],
        "title": "AutocompleteResult",
        "type": "object"
      },
      "AutocompleteSuggestion": {
        "description": "One normalized title suggestion.",
        "properties": {
          "cover": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GameCover"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "exclusiveMinimum": 0.0,
            "title": "Id",
            "type": "integer"
          },
          "releaseYear": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Releaseyear"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "slug",
          "title",
          "releaseYear",
          "cover"
        ],
        "title": "AutocompleteSuggestion",
        "type": "object"
      },
      "BrowseQuery": {
        "description": "Normalized public criteria echoed with browse results.",
        "properties": {
          "direction": {
            "$ref": "#/components/schemas/SortDirection"
          },
          "sort": {
            "$ref": "#/components/schemas/SortOption"
          }
        },
        "required": [
          "sort",
          "direction"
        ],
        "title": "BrowseQuery",
        "type": "object"
      },
      "CatalogOption": {
        "description": "Stable identifier and English source label for one filter option.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          }
        },
        "required": [
          "id",
          "label"
        ],
        "title": "CatalogOption",
        "type": "object"
      },
      "DurationKind": {
        "description": "Supported campaign-duration measures.",
        "enum": [
          "fast",
          "normal",
          "completionist"
        ],
        "title": "DurationKind",
        "type": "string"
      },
      "ErrorCode": {
        "description": "Stable failure codes understood by public adapters.",
        "enum": [
          "GAME_NOT_FOUND",
          "INTERNAL_ERROR",
          "INVALID_QUERY",
          "METHOD_NOT_ALLOWED",
          "NOT_FOUND",
          "RATE_LIMITED",
          "UPSTREAM_INVALID_RESPONSE",
          "UPSTREAM_TIMEOUT",
          "UPSTREAM_UNAVAILABLE",
          "VALIDATION_ERROR"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "ErrorDetail": {
        "description": "Public details nested inside an error response.",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "requestId": {
            "title": "Requestid",
            "type": "string"
          },
          "retryAfterSeconds": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retryafterseconds"
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "Public envelope shared by every error response.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "FilterLimits": {
        "description": "Public bounds shared by filter controls and query validation.",
        "properties": {
          "maximumDurationHours": {
            "title": "Maximumdurationhours",
            "type": "integer"
          },
          "maximumNameLength": {
            "title": "Maximumnamelength",
            "type": "integer"
          },
          "maximumPage": {
            "title": "Maximumpage",
            "type": "integer"
          },
          "minimumAutocompleteLength": {
            "title": "Minimumautocompletelength",
            "type": "integer"
          },
          "minimumDurationHours": {
            "title": "Minimumdurationhours",
            "type": "integer"
          },
          "pageSize": {
            "title": "Pagesize",
            "type": "integer"
          }
        },
        "required": [
          "pageSize",
          "maximumPage",
          "minimumAutocompleteLength",
          "maximumNameLength",
          "minimumDurationHours",
          "maximumDurationHours"
        ],
        "title": "FilterLimits",
        "type": "object"
      },
      "FilterMetadata": {
        "description": "All allow-listed values needed to construct the search form.",
        "properties": {
          "durationKinds": {
            "items": {
              "$ref": "#/components/schemas/DurationKind"
            },
            "title": "Durationkinds",
            "type": "array"
          },
          "gameModes": {
            "items": {
              "$ref": "#/components/schemas/CatalogOption"
            },
            "title": "Gamemodes",
            "type": "array"
          },
          "genres": {
            "items": {
              "$ref": "#/components/schemas/CatalogOption"
            },
            "title": "Genres",
            "type": "array"
          },
          "limits": {
            "$ref": "#/components/schemas/FilterLimits"
          },
          "platforms": {
            "items": {
              "$ref": "#/components/schemas/CatalogOption"
            },
            "title": "Platforms",
            "type": "array"
          },
          "sortOptions": {
            "items": {
              "$ref": "#/components/schemas/SortOption"
            },
            "title": "Sortoptions",
            "type": "array"
          }
        },
        "required": [
          "platforms",
          "genres",
          "gameModes",
          "durationKinds",
          "sortOptions",
          "limits"
        ],
        "title": "FilterMetadata",
        "type": "object"
      },
      "GameCover": {
        "description": "Normalized game cover image.",
        "properties": {
          "height": {
            "exclusiveMinimum": 0.0,
            "title": "Height",
            "type": "integer"
          },
          "url": {
            "title": "Url",
            "type": "string"
          },
          "width": {
            "exclusiveMinimum": 0.0,
            "title": "Width",
            "type": "integer"
          }
        },
        "required": [
          "url",
          "width",
          "height"
        ],
        "title": "GameCover",
        "type": "object"
      },
      "GameModeId": {
        "description": "Stable public game-mode identifiers accepted by search.",
        "enum": [
          "single-player",
          "multiplayer",
          "co-operative",
          "split-screen",
          "massively-multiplayer-online",
          "battle-royale"
        ],
        "title": "GameModeId",
        "type": "string"
      },
      "GamePage": {
        "description": "One normalized page of game summaries.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/GameSummary"
            },
            "title": "Items",
            "type": "array"
          },
          "meta": {
            "$ref": "#/components/schemas/ResponseMeta"
          },
          "pagination": {
            "$ref": "#/components/schemas/Pagination"
          },
          "query": {
            "$ref": "#/components/schemas/BrowseQuery"
          }
        },
        "required": [
          "items",
          "pagination",
          "query",
          "meta"
        ],
        "title": "GamePage",
        "type": "object"
      },
      "GameRating": {
        "description": "Normalized rating and the number of contributing scores.",
        "properties": {
          "count": {
            "minimum": 0.0,
            "title": "Count",
            "type": "integer"
          },
          "source": {
            "title": "Source",
            "type": "string"
          },
          "value": {
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Value",
            "type": "number"
          }
        },
        "required": [
          "value",
          "count",
          "source"
        ],
        "title": "GameRating",
        "type": "object"
      },
      "GameSummary": {
        "description": "Provider-neutral game data required by browse results.",
        "properties": {
          "cover": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GameCover"
              },
              {
                "type": "null"
              }
            ]
          },
          "gameModes": {
            "items": {
              "$ref": "#/components/schemas/CatalogOption"
            },
            "title": "Gamemodes",
            "type": "array"
          },
          "genres": {
            "items": {
              "$ref": "#/components/schemas/CatalogOption"
            },
            "title": "Genres",
            "type": "array"
          },
          "id": {
            "exclusiveMinimum": 0.0,
            "title": "Id",
            "type": "integer"
          },
          "normalDurationSeconds": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Normaldurationseconds"
          },
          "platforms": {
            "items": {
              "$ref": "#/components/schemas/CatalogOption"
            },
            "title": "Platforms",
            "type": "array"
          },
          "rating": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GameRating"
              },
              {
                "type": "null"
              }
            ]
          },
          "releaseYear": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Releaseyear"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "slug",
          "title",
          "releaseYear",
          "cover",
          "platforms",
          "genres",
          "rating",
          "normalDurationSeconds",
          "gameModes"
        ],
        "title": "GameSummary",
        "type": "object"
      },
      "GenreId": {
        "description": "Stable public genre identifiers accepted by search.",
        "enum": [
          "point-and-click",
          "fighting",
          "shooter",
          "music",
          "platform",
          "puzzle",
          "racing",
          "real-time-strategy-rts",
          "role-playing-rpg",
          "simulator",
          "sport",
          "strategy",
          "turn-based-strategy-tbs",
          "tactical",
          "hack-and-slash-beat-em-up",
          "quiz-trivia",
          "pinball",
          "adventure",
          "indie",
          "arcade",
          "visual-novel",
          "card-board-game",
          "moba"
        ],
        "title": "GenreId",
        "type": "string"
      },
      "HealthResponse": {
        "description": "Stable public response for process-health checks.",
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "HealthResponse",
        "type": "object"
      },
      "Pagination": {
        "description": "Page location and total result information.",
        "properties": {
          "page": {
            "minimum": 1.0,
            "title": "Page",
            "type": "integer"
          },
          "pageSize": {
            "const": 24,
            "default": 24,
            "title": "Pagesize",
            "type": "integer"
          },
          "totalItems": {
            "minimum": 0.0,
            "title": "Totalitems",
            "type": "integer"
          },
          "totalPages": {
            "minimum": 0.0,
            "title": "Totalpages",
            "type": "integer"
          }
        },
        "required": [
          "page",
          "totalItems",
          "totalPages"
        ],
        "title": "Pagination",
        "type": "object"
      },
      "PlatformId": {
        "description": "Stable public platform identifiers accepted by search.",
        "enum": [
          "pc",
          "playstation-4",
          "playstation-5",
          "xbox-one",
          "xbox-series-x-s",
          "nintendo-switch"
        ],
        "title": "PlatformId",
        "type": "string"
      },
      "ResponseMeta": {
        "description": "Freshness and processing metadata for one catalog response.",
        "properties": {
          "dataMayBeStale": {
            "default": false,
            "title": "Datamaybestale",
            "type": "boolean"
          },
          "excludedUnknownDuration": {
            "default": false,
            "title": "Excludedunknownduration",
            "type": "boolean"
          },
          "requestId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Requestid"
          },
          "servedFrom": {
            "$ref": "#/components/schemas/ServedFrom",
            "default": "provider"
          }
        },
        "title": "ResponseMeta",
        "type": "object"
      },
      "ServedFrom": {
        "description": "Origin of the data returned to the caller.",
        "enum": [
          "provider"
        ],
        "title": "ServedFrom",
        "type": "string"
      },
      "SortDirection": {
        "description": "Provider-neutral ordering direction.",
        "enum": [
          "asc",
          "desc"
        ],
        "title": "SortDirection",
        "type": "string"
      },
      "SortOption": {
        "description": "Supported catalog sort fields.",
        "enum": [
          "popularity",
          "rating",
          "release-date",
          "duration",
          "title"
        ],
        "title": "SortOption",
        "type": "string"
      }
    }
  },
  "info": {
    "description": "Provider-neutral game discovery API.",
    "title": "What To Play Next API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/filters": {
      "get": {
        "description": "Return stable filter options from the configured catalog.",
        "operationId": "getFilters",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FilterMetadata"
                }
              }
            },
            "description": "Successful Response",
            "headers": {
              "X-Request-ID": {
                "description": "Identifier used to correlate this response.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "405": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Method not allowed.",
            "headers": {
              "X-Request-ID": {
                "description": "Identifier used to correlate this response.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too many requests.",
            "headers": {
              "X-Request-ID": {
                "description": "Identifier used to correlate this response.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "An unexpected error occurred.",
            "headers": {
              "X-Request-ID": {
                "description": "Identifier used to correlate this response.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Game data provider returned an invalid response.",
            "headers": {
              "X-Request-ID": {
                "description": "Identifier used to correlate this response.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Game data is temporarily unavailable.",
            "headers": {
              "X-Request-ID": {
                "description": "Identifier used to correlate this response.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Game data provider timed out.",
            "headers": {
              "X-Request-ID": {
                "description": "Identifier used to correlate this response.",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "summary": "Get catalog filter metadata",
        "tags": [
          "catalog"
        ]
      }
    },
    "/api/v1/games": {
      "get": {
        "description": "Return one strict, normalized page of catalog results.",
        "operationId": "browseGames",
        "parameters": [
          {
            "in": "query",
            "name": "name",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 100,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Name"
            }
          },
          {
            "in": "query",
            "name": "platform",
            "required": false,
            "schema": {
              "items": {
                "$ref": "#/components/schemas/PlatformId"
              },
              "title": "Platform",
              "type": "array"
            }
          },
          {
            "in": "query",
            "name": "genre",
            "required": false,
            "schema": {
              "items": {
                "$ref": "#/components/schemas/GenreId"
              },
              "title": "Genre",
              "type": "array"
            }
          },
          {
            "in": "query",
            "name": "releaseFrom",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Releasefrom"
            }
          },
          {
            "in": "query",
            "name": "releaseTo",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Releaseto"
            }
          },
          {
            "in": "query",
            "name": "minimumRating",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 100,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Minimumrating"
            }
          },
          {
            "in": "query",
            "name": "gameMode",
            "required": false,
            "schema": {
              "items": {
                "$ref": "#/components/schemas/GameModeId"
              },
              "title": "Gamemode",
              "type": "array"
            }
          },
          {
            "in": "query",
            "name": "durationKind",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/DurationKind",
              "default": "normal"
            }
          },
          {
            "in": "query",
            "name": "minimumDurationHours",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 1000,
                  "minimum": 1,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Minimumdurationhours"
            }
          },
          {
            "in": "query",
            "name": "maximumDurationHours",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 1000,
                  "minimum": 1,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Maximumdurationhours"
            }
          },
          {
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/SortOption",
              "default": "popularity"
            }
          },
          {
            "in": "query",
            "name": "direction",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/SortDirection"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Direction"
            }
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "maximum": 100,
              "minimum": 1,
              "title": "Page",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GamePage"
                }
              }
            },
            "description": "Successful Response",
            "headers": {
              "X-Request-ID": {
                "description": "Identifier used to correlate this response.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "405": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Method not allowed.",
            "headers": {
              "X-Request-ID": {
                "description": "Identifier used to correlate this response.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "One or more parameter values are invalid.",
            "headers": {
              "X-Request-ID": {
                "description": "Identifier used to correlate this response.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too many requests.",
            "headers": {
              "X-Request-ID": {
                "description": "Identifier used to correlate this response.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "An unexpected error occurred.",
            "headers": {
              "X-Request-ID": {
                "description": "Identifier used to correlate this response.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Game data provider returned an invalid response.",
            "headers": {
              "X-Request-ID": {
                "description": "Identifier used to correlate this response.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Game data is temporarily unavailable.",

# This value is included in the browser bundle and must never contain secrets.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Server-only public origin used to build absolute canonical and social URLs.
WTPN_SITE_ORIGIN=http://localhost:3000

# Server-only secret shared with the API's WTPN_EDGE_TOKEN. With it, API calls
# made for a visitor carry that visitor's address for per-visitor rate limits.
# Never give it a NEXT_PUBLIC_ prefix. Leave blank to forward nothing.
WTPN_API_EDGE_TOKEN=

# Anonymous analytics (Umami). The website ID is public by design; leave it
# blank to render no script and send nothing. The script URL defaults to
# Umami Cloud; set the host URL only if events go to a different origin.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_HOST_URL=

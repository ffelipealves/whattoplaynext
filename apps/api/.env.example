# Application
WTPN_ENVIRONMENT=local
WTPN_DEBUG=false
WTPN_API_PREFIX=/api/v1

# Infrastructure. Leave the Redis URL blank to run with the cache disabled.
WTPN_REDIS_URL=redis://localhost:6380/0

# Server-side provider credentials. Leave both blank until IGDB access is used.
WTPN_TWITCH_CLIENT_ID=
WTPN_TWITCH_CLIENT_SECRET=

# Per-visitor rate limiting. In production all three values are required: the
# edge token must match the web server's WTPN_API_EDGE_TOKEN, the HMAC key must
# be unique per environment, and proxy hops must be explicit. Use 0 only when
# the API has no hosting proxy in front of it.
WTPN_EDGE_TOKEN=
WTPN_IDENTITY_HMAC_KEY=
WTPN_TRUSTED_PROXY_HOPS=0
WTPN_RATE_LIMIT_PUBLIC_PER_MINUTE=60
WTPN_RATE_LIMIT_PROVIDER_PER_MINUTE=20

# Process-wide IGDB ceiling: at most IGDB's own 4 requests/second and 8 open.
WTPN_PROVIDER_REQUESTS_PER_SECOND=4
WTPN_PROVIDER_MAX_IN_FLIGHT=8

# Circuit breaker around IGDB: consecutive failures before opening, the first
# open period, and the cap it doubles up to after failed probes.
WTPN_CIRCUIT_FAILURE_THRESHOLD=5
WTPN_CIRCUIT_OPEN_SECONDS=30
WTPN_CIRCUIT_MAX_OPEN_SECONDS=300

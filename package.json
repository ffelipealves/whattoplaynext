{
  "name": "whattoplaynext",
  "private": true,
  "scripts": {
    "setup": "pnpm install && poetry -C apps/api install && pnpm e2e:install",
    "dev": "pnpm build:contracts && concurrently --kill-others-on-fail --names web,api \"pnpm dev:web\" \"pnpm dev:api\"",
    "dev:web": "pnpm build:contracts && pnpm --filter web dev",
    "dev:api": "poetry -C apps/api run fastapi dev src/whattoplaynext_api/main.py",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs --follow redis",
    "infra:status": "docker compose ps",
    "contract:generate": "node tools/contracts.mjs generate",
    "contract:check": "node tools/contracts.mjs check",
    "format": "pnpm format:repo && pnpm format:api",
    "format:check": "pnpm format:repo:check && pnpm format:api:check",
    "format:repo": "prettier --write . --ignore-unknown",
    "format:repo:check": "prettier --check . --ignore-unknown",
    "format:api": "poetry -C apps/api run ruff format .",
    "format:api:check": "poetry -C apps/api run ruff format --check .",
    "lint": "pnpm lint:repo && pnpm lint:web && pnpm lint:api",
    "lint:repo": "eslint eslint.config.mjs tools packages/contracts/src packages/contracts/vitest.config.mts",
    "lint:web": "pnpm --filter web lint",
    "lint:api": "poetry -C apps/api run ruff check .",
    "typecheck": "pnpm typecheck:contracts && pnpm typecheck:web && pnpm typecheck:api",
    "typecheck:contracts": "pnpm --filter @whattoplaynext/contracts typecheck",
    "typecheck:web": "pnpm --filter web typecheck",
    "typecheck:api": "poetry -C apps/api run mypy",
    "test": "pnpm test:contracts && pnpm test:web && pnpm test:api",
    "test:contracts": "pnpm --filter @whattoplaynext/contracts test",
    "test:web": "pnpm --filter web test",
    "test:api": "poetry -C apps/api run pytest",
    "coverage": "pnpm coverage:contracts && pnpm coverage:web && pnpm coverage:api",
    "coverage:contracts": "pnpm --filter @whattoplaynext/contracts test:coverage",
    "coverage:web": "pnpm --filter web test:coverage",
    "coverage:api": "poetry -C apps/api run pytest --cov=whattoplaynext_api --cov-report=term-missing --cov-report=xml:coverage.xml",
    "e2e": "pnpm --filter web e2e",
    "e2e:browsers": "pnpm --filter web e2e:browsers",
    "e2e:vitals": "pnpm --filter web e2e:vitals",
    "e2e:install": "pnpm --filter web exec playwright install --with-deps chromium",
    "e2e:install:browsers": "pnpm --filter web exec playwright install --with-deps chromium firefox webkit",
    "build": "pnpm build:contracts && pnpm build:web && pnpm build:api",
    "build:contracts": "pnpm --filter @whattoplaynext/contracts build",
    "build:web": "pnpm --filter web build",
    "build:api": "poetry -P apps/api build",
    "quality": "pnpm contract:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm coverage && pnpm e2e && pnpm build",
    "check": "pnpm quality",
    "smoke:api": "poetry -C apps/api run python scripts/smoke_igdb.py"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "concurrently": "10.0.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "typescript-eslint": "8.70.0"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.0.0 <25",
    "pnpm": ">=11.19.0 <12"
  }
}
